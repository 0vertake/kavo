# Copy to cluster.env on each host (or one file shared over ssh) and edit the
# addresses. Every kavod node must advertise an address its peers can dial; the
# S3 port is what clients and benchmarks use.
#
# etcd can run on one of these hosts or elsewhere. Its client URL must be
# reachable from every node — not 127.0.0.1 unless etcd is local to that node.

KAVO_ETCD=10.0.0.10:2379
KAVO_CLUSTER=/kavo

# Credentials for S3 benchmarks (kavod defaults; change in production).
KAVO_ACCESS_KEY=kavo
KAVO_SECRET_KEY=kavosecret

# Where to run `make bench-remote` from — any node's S3 API works.
KAVO_BENCH_ENDPOINT=http://10.0.0.11:9000

# Per-node settings. Host is this machine's address on the cluster network.
# Internal API listens on KAVO_INTERNAL_PORT; S3 on KAVO_S3_PORT. Each host runs
# one row — copy the file and set KAVO_NODE to n1, n2, … on that host, or pass
# the id to scripts/kavod-node.sh.

KAVO_NODE=n1
KAVO_N1_HOST=10.0.0.11
KAVO_N1_INTERNAL_PORT=8080
KAVO_N1_S3_PORT=9000
KAVO_N1_DATA=/var/lib/kavo/n1

KAVO_N2_HOST=10.0.0.12
KAVO_N2_INTERNAL_PORT=8080
KAVO_N2_S3_PORT=9000
KAVO_N2_DATA=/var/lib/kavo/n2

KAVO_N3_HOST=10.0.0.13
KAVO_N3_INTERNAL_PORT=8080
KAVO_N3_S3_PORT=9000
KAVO_N3_DATA=/var/lib/kavo/n3

KAVO_N4_HOST=10.0.0.14
KAVO_N4_INTERNAL_PORT=8080
KAVO_N4_S3_PORT=9000
KAVO_N4_DATA=/var/lib/kavo/n4

KAVO_N5_HOST=10.0.0.15
KAVO_N5_INTERNAL_PORT=8080
KAVO_N5_S3_PORT=9000
KAVO_N5_DATA=/var/lib/kavo/n5

KAVO_N6_HOST=10.0.0.16
KAVO_N6_INTERNAL_PORT=8080
KAVO_N6_S3_PORT=9000
KAVO_N6_DATA=/var/lib/kavo/n6
